		"main": [
			"com.boostermod.BoosterMod"
		],
		"client": [
			"com.boostermod.client.BoosterModClient"
		]
	},
	"mixins": [
		"boostermod.client.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.2",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"trinkets": ">=3.10.0"
	}
